{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/onboarding-process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/appointment-reminder",
      "schedule": "* * * * *"
    }
  ]
}