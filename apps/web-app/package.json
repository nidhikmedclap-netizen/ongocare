{
  "name": "glp1-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:marketing",
    "dev:marketing": "cross-env NEXT_DIST_DIR=.next-marketing next dev -p 3000",
    "dev:dashboard": "cross-env NEXT_DIST_DIR=.next-dashboard next dev -p 3001",
    "dev:split": "concurrently -n marketing,dashboard -c blue,green \"npm run dev:marketing\" \"npm run dev:dashboard\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test e2e/auth",
    "test:e2e:auth:public": "playwright test e2e/auth/middleware.spec.js",
    "test:e2e:auth:live": "cross-env E2E_SKIP_WEBSERVER=true playwright test e2e/auth",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "next": "14.2.5",
    "nodemailer": "^8.0.10",
    "radix-ui": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.39",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.6"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ]
}
