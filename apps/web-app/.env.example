# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables.

# ── Firebase client (browser) — from Firebase Console → Project settings → Your apps ──
# Also enable Google under Authentication → Sign-in method, and add your domains
# (localhost, web.ongoweightloss.com, *.vercel.app) under Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Exact value from Firebase Console → Storage (e.g. my-project-id.firebasestorage.app).
# Required on Vercel Preview + Production — .env.local does not deploy to staging.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (server only) — from Firebase Console → Service accounts → Generate key ──
# FIREBASE_ADMIN_PROJECT_ID must match NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Server uploads (/api/storage/upload). Set on Vercel Preview + Production too.
FIREBASE_ADMIN_STORAGE_BUCKET=
# Paste the private key as one line with \n for line breaks (Vercel-friendly)
FIREBASE_ADMIN_PRIVATE_KEY=

# Patient/doctor onboarding uploads go through /api/storage/upload (server-side).
# No Firebase Storage CORS setup is required for new domains.
#
# Leave both empty (or set to the same value) for single-host local dev.
# When set to different URLs:
#   Marketing — homepage, onboarding, login/register (all auth UI)
#   Dashboard — /dashboard/* and /auth/callback (app after sign-in)
# Login always happens on marketing; a one-time handoff opens the dashboard session.
# Session security: HTTP-only __session cookie verified in middleware + API routes.
# Local split-site: npm run dev:marketing (3000) + npm run dev:dashboard (3001).
#
# NEXT_PUBLIC_DISABLE_SITE_SPLIT — force single-host (no cross-domain handoff).
#   Production (custom domains): leave empty or false.
#   Preview (*.vercel.app): set to true so branch deploys login on the same host.
#   Vercel tip: scope DISABLE=true to Preview only; keep origins on Production only.
NEXT_PUBLIC_DISABLE_SITE_SPLIT=
NEXT_PUBLIC_MARKETING_ORIGIN=https://web.ongoweightloss.com
NEXT_PUBLIC_DASHBOARD_ORIGIN=https://weightloss.ongocare.com

# ── Stripe (optional until payments) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe → Developers → Webhooks (payment_intent.succeeded, payment_intent.canceled)
STRIPE_WEBHOOK_SECRET=

# ── SMTP via Resend (password reset + transactional email) ──
# 1. Sign up at https://resend.com
# 2. API Keys → Create API Key (starts with re_)
# 3. Domains → add + verify your domain (or use onboarding@resend.dev for testing)
# Docs: https://resend.com/docs/send-with-nodemailer-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Verified sender on your Resend domain, e.g. noreply@ongoweightloss.com
# For quick testing only: onboarding@resend.dev (can only send to your Resend account email)
SMTP_FROM=
# Optional alias — if set, used as SMTP_PASS when SMTP_PASS is empty
RESEND_API_KEY=

# Optional — extra hosts allowed as Firebase password-reset return URLs
# (comma-separated). Add your Vercel preview host if needed, e.g.:
# PASSWORD_RESET_CONTINUE_HOSTS=my-app.vercel.app
PASSWORD_RESET_CONTINUE_HOSTS=

# Vercel Cron — protects /api/cron/* routes (Bearer token on each invocation)
CRON_SECRET=

# ── E2E auth tests (Playwright) — optional, for npm run test:e2e:auth ──
# Use a dedicated Firebase test patient account (not production admin).
# E2E_TEST_EMAIL=patient-test@example.com
# E2E_TEST_PASSWORD=your-test-password
# E2E_MARKETING_ORIGIN=http://localhost:3000
# E2E_DASHBOARD_ORIGIN=http://localhost:3001
# E2E_SKIP_WEBSERVER=true
