# =============================================================================
# Production (ongovoiceapp-taskor / Docker on the host)
# =============================================================================
# On the server, this file must live at:
#   /root/ongovoiceapp-taskor/.env
#
# Copy this example there, fill every required value, then:
#   cd /root/ongovoiceapp-taskor
#   docker compose --env-file .env up -d
#
# Validate before/after deploy (prints OK / missing keys only — never values):
#   cd /root/ongovoiceapp-taskor   # or clone path where server/package.json lives
#   node /path/to/TwilioCallApp/server/verify-env.mjs .env --production
#   (--production also requires TWILIO_VOICE_CLIENT_IDENTITY, PUBLIC_BASE_URL, TWILIO_AUTH_TOKEN)
#
# Voice JWT (/api/voice-session, /token) is implemented in server/index.js in Docker;
# keep the same variable names as token-server.mjs in this repo.
# =============================================================================

# --- Required for Voice JWT (GET /api/voice-session, GET /token) ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# --- Strongly recommended (PSTN <Dial><Client> + app identity alignment) ---
TWILIO_VOICE_CLIENT_IDENTITY=voice_client

# --- iOS incoming (VoIP push) — set BOTH so Xcode (sandbox) and TestFlight (production) work ---
# App sends ?apns=sandbox (Debug) or ?apns=production (Release). Server picks matching CR… SID.
# TWILIO_VOICE_PUSH_CREDENTIAL_SID_SANDBOX=CRxxxxxxxx   # Twilio: Apple VoIP — Sandbox/Development
# TWILIO_VOICE_PUSH_CREDENTIAL_SID_PRODUCTION=CRxxxxxxxx # Twilio: Apple VoIP — Production
# Legacy single SID (used if the matching _SANDBOX / _PRODUCTION var is unset):
# TWILIO_VOICE_PUSH_CREDENTIAL_SID=CRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Strongly recommended (absolute https origin for Twilio voicemail callbacks) ---
# PUBLIC_BASE_URL=https://ongovoiceapp.taskor.io

# --- Required for SMS, recording proxy, phone-number list (REST) ---
TWILIO_AUTH_TOKEN=

# If set, these routes require: Authorization: Bearer <same value>
# GET /api/sms/inbound, POST /api/sms/send, GET /api/twilio/phone-numbers, GET /api/voicemails, …
APP_BEARER_TOKEN=

# Optional: accept Firebase ID tokens from app requests (header: X-Firebase-ID-Token).
# When enabled, app users can call protected APIs without manually entering APP_BEARER_TOKEN on each device.
# Server must run with Google credentials that can verify Firebase Auth tokens.
# FIREBASE_PROJECT_ID=ongoios
# Optional hard mode: require Firebase ID token when APP_BEARER_TOKEN is unset.
# REQUIRE_FIREBASE_ID_TOKEN=0

TWILIO_DEFAULT_SMS_FROM=
TWILIO_DEFAULT_VOICE_FROM=

PORT=3001

# If PUBLIC_BASE_URL is unset, some installs derive it from Host / X-Forwarded-* (works for curl;
# production should still set PUBLIC_BASE_URL explicitly).

# Optional: seconds to ring the app before voicemail (default 25).
# TWILIO_VOICEMAIL_RING_TIMEOUT=25

# Voicemail <Record>: leave unset or 0 so recordings work without Twilio transcription. Set to 1 only if your account supports Record transcription.
# TWILIO_VOICEMAIL_TRANSCRIBE=0

# Optional: default voicemail prompt when a number is not listed in voice-inbound-lines.json.
# TWILIO_VOICEMAIL_GREETING_DEFAULT=Sorry, no one is available. Please leave a message after the tone.

# Optional: per-number voicemail (E.164), ring time, greeting, optional clientIdentity — copy the example file:
#   cp data/voice-inbound-lines.example.json data/voice-inbound-lines.json
# Or set a custom path:
# VOICE_INBOUND_LINES_PATH=/var/lib/twilio-call-app/voice-inbound-lines.json

# Optional: persisted voicemail index (default ./data/voicemail-log.json)
# VOICEMAIL_LOG_PATH=

# Optional: merge Twilio account recordings into GET /api/voicemails (default on when TWILIO_AUTH_TOKEN is set). Set to 0 to disable.
# TWILIO_RECORDINGS_IN_VOICEMAIL_LIST=1
# Optional: max recordings to fetch from Twilio per request (default 50, max 100).
# TWILIO_RECORDINGS_LIST_LIMIT=50

# Optional: SMS thank-you to the caller after they leave a voicemail (uses recording completed webhook; delay then Twilio REST).
# Requires TWILIO_AUTH_TOKEN and a Messaging-capable From number (TWILIO_DEFAULT_SMS_FROM or TWILIO_VOICEMAIL_THANKYOU_SMS_FROM).
# TWILIO_VOICEMAIL_THANKYOU_SMS_ENABLED=1
# TWILIO_VOICEMAIL_THANKYOU_SMS_TEXT=Thanks for your message. We'll get back to you soon.
# Optional: milliseconds to wait before sending (default 5000).
# TWILIO_VOICEMAIL_THANKYOU_SMS_DELAY_MS=5000
# Optional: override From for this message only (else TWILIO_DEFAULT_SMS_FROM).
# TWILIO_VOICEMAIL_THANKYOU_SMS_FROM=+15551234567
# Template may include placeholders: {from} caller E.164, {to} and {line} dialed mailbox / your number.

# Optional: SMS when a caller misses you (DialCallStatus no-answer/busy/failed/canceled).
# Requires TWILIO_AUTH_TOKEN and a Messaging-capable From number (uses the dialed line first, else TWILIO_DEFAULT_SMS_FROM).
# TWILIO_MISSED_CALL_SMS_ENABLED=1
# TWILIO_MISSED_CALL_SMS_TEXT=Sorry we missed your call. How can we help?
# Optional: milliseconds to wait before sending (default 4000).
# TWILIO_MISSED_CALL_SMS_DELAY_MS=4000
# Optional: persisted log to prevent duplicate sends (default ./data/missed-call-sms-log.json)
# MISSED_CALL_LOG_PATH=/var/lib/twilio-call-app/missed-call-sms-log.json

# Twilio Console → TwiML Apps → your app → Voice URL:
#   https://YOUR_HOST/webhook/voice
#
# Twilio Console → Phone Numbers → Voice → "A call comes in":
#   https://YOUR_HOST/webhook/voice-incoming  (HTTP POST)
#
# Twilio Console → Phone Numbers → Messaging → "A message comes in":
#   https://YOUR_HOST/webhook/sms  (HTTP POST)
#
# Optional: persist inbound/outbound SMS log across restarts (default ./data/sms-log.json)
# SMS_LOG_PATH=/var/lib/twilio-call-app/sms-log.json
