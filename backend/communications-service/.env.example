# Copy to .env and fill in real values. Never commit .env.

PORT=3102
FIREBASE_PROJECT_ID=ongo-dev
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_API_KEY_SID=your-twilio-api-key-sid
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=+15551234567
SMS_APP_API_KEY=
COMMUNICATIONS_PUBLIC_URL=https://communications.ongocare.com
COMMUNICATIONS_DEFAULT_ORG_SLUG=ongo
COMMUNICATIONS_ORG_NAME=Ongo Weight Loss
COMMUNICATIONS_ORG_PRODUCT=weight_loss
ORG_PHONE_MAPPINGS=+15551234567=ongo
HUB_AUTH_STRICT=false
HUB_SERVICE_ACCOUNT_KEY_ID=
SERVICE_ACCOUNT_ORG_SLUGS=ongo|esa|mmj|weightloss
HUB_SERVICE_ACCOUNTS=sms-app=ongo|esa|mmj|weightloss
ORG_MEMBERSHIPS=
CHAT_VISITOR_TOKEN_SECRET=
CHAT_ORIGIN_BYPASS=false
CHAT_SITE_SEEDS=weightloss-main=weightloss:weightloss.com|www.weightloss.com|localhost
